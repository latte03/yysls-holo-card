# ---- 依赖与构建产物 ----
site/node_modules/
site/dist/
__pycache__/
*.pyc

# 每张卡的壳页由 gen-card-pages.mjs 从 card.template.html 扇出，是产物不是源
# （pnpm dev / pnpm build 会先生成）。唯一源：card.template.html + cards.manifest.js。
site/*/index.html

# ---- Blender 工程与参考图（均可由管线重建）----
# card.blend 由 build_card.py 生成；改了 assets/ 的 png 必须重跑它才生效，
# 所以它是产物而非源。renders/ 与 preview-*.png 是目检参考图，站点不引用。
cards/*/card.blend
cards/*/card.blend1
cards/*/renders/
cards/*/preview-*.png
cards/*/assets/
cards/*/tools/

# ---- 归档（旧 blend 备份、废弃素材、zip）----
# 只忽略每张卡自己的 archive/；仓库根的 archive/legacy-v1/ 是 v1 弃稿代码，要留档。
cards/*/archive/

# ---- 系统垃圾 ----
.DS_Store
*.log

# ---- 本地发布绑定（含项目/站点 ID，按需决定是否入库）----
# .燕云十六声 · 典藏闪卡.qoder.site

# ---- 方正金隶原库（商用授权另议，不推公开仓库）----
# 整站正文子集 site/public/fonts/*.woff2 已入库，站点运行不依赖原库；
# 只有重跑 site/make_font.py 才需要它——本机这份是唯一副本，删了要重新弄。
brand/fonts/FZJinLS-B-GB.ttf

# ---- Understand-Anything 知识图谱 ----
# 图谱本身入库（178 KB，别人 clone 后无需 LLM 即可用 viewer 打开）；
# intermediate/ 与 tmp/ 是逐批中间件，.trash-*/ 是 Phase 7 挪走的垃圾，diff-overlay.json 是本地临时覆盖层。
.ua/intermediate/
.ua/tmp/
.ua/.trash-*/
.ua/diff-overlay.json

# 说明：cards/*/source/ 是用户交付的原始素材，**唯一副本，删了无法重建**，务必入库。
#       site/public/assets/ 是站点运行所需（WebP + glb），同样要入库——
#       它让 `pnpm install && pnpm dev` 在干净克隆上直接跑起来。
